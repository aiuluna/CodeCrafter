{
  "name": "element-ui-plus-renderer",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "cross-env VITE_PORT=3006 vite",
    "build": "vite build --emptyOutDir",
    "generate": "vite-ssg build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "pages:preview": "npx wrangler pages dev dist",
    "deploy": "npm run build && npx wrangler pages deploy dist",
    "build:docker": "docker build -t element-ui-plus-renderer:latest ."
  },
  "dependencies": {
    "@lefit/aries-ui": "^1.4.5",
    "@lefit/aries-ui-icon": "^1.0.5",
    "dayjs": "^1.11.13",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@iconify-json/ep": "^1.1.15",
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "cross-env": "^7.0.3",
    "sass": "^1.72.0",
    "typescript": "^5.4.3",
    "unocss": "^0.58.6",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.2.5",
    "vite-ssg": "^0.23.6",
    "vue-tsc": "^2.0.7"
  },
  "license": "MIT"
}